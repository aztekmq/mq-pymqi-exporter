* Enable the main monitoring feeds this repo cares about.
ALTER QMGR ACCTQ(ON) STATQ(ON)

* Queue-manager level inquiry and display access for both the OS group and the
* concrete client principal used by the exporter.
SET AUTHREC GROUP('monitoring') OBJTYPE(QMGR) AUTHADD(CONNECT,INQ,DSP)
SET AUTHREC PRINCIPAL('app') OBJTYPE(QMGR) AUTHADD(CONNECT,INQ,DSP)

* PCF-based collection sends requests to the admin command queue and consumes
* replies from a dynamic queue based on the default model queue.
SET AUTHREC PROFILE('SYSTEM.ADMIN.COMMAND.QUEUE') OBJTYPE(QUEUE) GROUP('monitoring') AUTHADD(PUT,INQ,DSP)
SET AUTHREC PROFILE('SYSTEM.ADMIN.COMMAND.QUEUE') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(PUT,INQ,DSP)
SET AUTHREC PROFILE('SYSTEM.DEFAULT.MODEL.QUEUE') OBJTYPE(QUEUE) GROUP('monitoring') AUTHADD(PUT,GET,INQ,DSP)
SET AUTHREC PROFILE('SYSTEM.DEFAULT.MODEL.QUEUE') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(PUT,GET,INQ,DSP)

* Consume accounting, statistics, and core event messages.
SET AUTHREC PROFILE('SYSTEM.ADMIN.ACCOUNTING.QUEUE') OBJTYPE(QUEUE) GROUP('monitoring') AUTHADD(DSP,INQ,GET)
SET AUTHREC PROFILE('SYSTEM.ADMIN.ACCOUNTING.QUEUE') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(DSP,INQ,GET)
SET AUTHREC PROFILE('SYSTEM.ADMIN.STATISTICS.QUEUE') OBJTYPE(QUEUE) GROUP('monitoring') AUTHADD(DSP,INQ,GET)
SET AUTHREC PROFILE('SYSTEM.ADMIN.STATISTICS.QUEUE') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(DSP,INQ,GET)
SET AUTHREC PROFILE('SYSTEM.ADMIN.QMGR.EVENT') OBJTYPE(QUEUE) GROUP('monitoring') AUTHADD(DSP,INQ,GET)
SET AUTHREC PROFILE('SYSTEM.ADMIN.QMGR.EVENT') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(DSP,INQ,GET)
SET AUTHREC PROFILE('SYSTEM.ADMIN.PERF.EVENT') OBJTYPE(QUEUE) GROUP('monitoring') AUTHADD(DSP,INQ,GET)
SET AUTHREC PROFILE('SYSTEM.ADMIN.PERF.EVENT') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(DSP,INQ,GET)

* Subscribe to the system metrics topic and allow use of a managed subscription queue.
SET AUTHREC PROFILE('SYSTEM.ADMIN.TOPIC') OBJTYPE(TOPIC) GROUP('monitoring') AUTHADD(SUB,RESUME)
SET AUTHREC PROFILE('SYSTEM.ADMIN.TOPIC') OBJTYPE(TOPIC) PRINCIPAL('app') AUTHADD(SUB,RESUME)
